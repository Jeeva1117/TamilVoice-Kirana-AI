# ==============================================================================
# TamilVoice Kirana AI - Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control or expose API keys.
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# Database Configuration
# Local Development (SQLite):
DATABASE_URL=sqlite:///./kirana_ai.db
# Production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=15.0

# Gnani.ai Unified Voice Platform (Prisma v2.5 STT & Timbre v2.5 TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_LANG_CODE=ta-IN
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_STT_ENABLED=true
GNANI_TTS_ENABLED=true
GNANI_API_BASE_URL=https://api.vachana.ai

# Frontend & CORS Configuration
# Set your Vercel frontend domain in production (e.g., https://tamilvoice-kirana.vercel.app)
FRONTEND_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Vercel Deployment Frontend Environment Variable
# In Vercel Project Settings > Environment Variables, configure:
# BACKEND_URL=https://tamilvoice-kirana-api.onrender.com/api
