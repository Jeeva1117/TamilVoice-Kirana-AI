# TamilVoice Kirana AI - Environment Configuration Example
# Copy this file to .env and fill in the required values. Never commit .env to version control.

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_secret_key

# Database Configuration
DATABASE_URL=sqlite:///./tamilvoice_kirana.db

# Gnani.ai Speech & Language Services
GNANI_API_KEY=your_gnani_api_key_here
GNANI_ACCESS_TOKEN=your_gnani_access_token_here
GNANI_LANG_CODE=ta-IN

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000
